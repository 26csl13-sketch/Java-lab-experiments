def canReach(arr, start):
    if start<0 or start>=len(arr) or arr[start]<0:
        return False
    if arr[start] == 0:
        return True

    jump = arr[start]
    arr[start] = -1
    return (canReach(arr,start+jump) or
            canReach(arr,start-jump))

arr = [4,2,3,0,3,1,2]
print(canReach(arr,5))


