2.2 Minimum Cost to Make Path
Program:


from collections import deque

def minCost(grid):
    m,n = len(grid),len(grid[0])
    d = [[999]*n for _ in range(m)]
    q = deque([(0,0)])
    d[0][0] = 0
    dirs = [(0,1),(0,-1),(1,0),(-1,0)]

    while q:
        x,y = q.popleft()
        for i,(dx,dy) in enumerate(dirs):
            a,b = x+dx,y+dy
            if 0<=a<m and 0<=b<n:
                c = d[x][y] + (grid[x][y] != i+1)
                if c < d[a][b]:
                    d[a][b] = c
                    if c == d[x][y]:
                        q.appendleft((a,b))
                    else:
                        q.append((a,b))

    return d[-1][-1]

print(minCost([[1,1,3],[3,2,2],[1,1,4]]))




2.3 Word Search using Trie
Program:



def findWords(board, words):
    result = []

    def dfs(r,c,w,path):
        if not w:
            result.append(path)
            return
        if r<0 or c<0 or r>=len(board) or c>=len(board[0]):
            return
        if board[r][c] != w[0]:
            return

        ch = board[r][c]
        board[r][c] = '#'
        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
            dfs(r+dr,c+dc,w[1:],path+ch)
        board[r][c] = ch

    for w in words:
        for i in range(len(board)):
            for j in range(len(board[0])):
                dfs(i,j,w,"")
    return list(set(result))

b = [['o','a','t'],['e','t','a'],['a','n','e']]
print(findWords(b,['oat','eat','tea']))



