2.1 Walls and Gates
Program:

from collections import deque

def solve(grid):
    q = deque()
    m, n = len(grid), len(grid[0])

    for i in range(m):
        for j in range(n):
            if grid[i][j] == 0:
                q.append((i,j))

    while q:
        x,y = q.popleft()
        for dx,dy in [(0,1),(0,-1),(1,0),(-1,0)]:
            a,b = x+dx,y+dy
            if 0<=a<m and 0<=b<n and grid[a][b]==999:
                grid[a][b] = grid[x][y]+1
                q.append((a,b))

grid = [[999,-1,0,999],
        [999,999,999,-1],
        [999,-1,999,-1],
        [0,-1,999,999]]

solve(grid)
for row in grid:
