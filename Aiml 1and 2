def exist(board, word):
    def dfs(r,c,i):
        if i == len(word):
            return True
        if r<0 or c<0 or r>=len(board) or c>=len(board[0]):
            return False
        if board[r][c] != word[i]:
            return False

        ch = board[r][c]
        board[r][c] = '#'
        ans = (dfs(r+1,c,i+1) or dfs(r-1,c,i+1)
               or dfs(r,c+1,i+1) or dfs(r,c-1,i+1))
        board[r][c] = ch
        return ans

    for i in range(len(board)):
        for j in range(len(board[0])):
            if dfs(i,j,0):
                return True
    return False

b = [['A','B','C'],['S','F','C'],['A','D','E']]
print(exist(b,"ABCCED"))


2.5 Jump Game III
