Experiment 4 – Constraint Satisfaction Problem


Aim:
To solve Constraint Satisfaction Problems
using backtracking algorithms.


Procedure:
Define the problem and constraints.
Initialize the required variables.
Apply backtracking to find a valid solution.
Display the final solution.


4.1 N-Queens Problem
Program:


def solve(n):
    board = [-1]*n

    def backtrack(r):
        if r == n:
            return True

        for c in range(n):
            if all(board[i]!=c and
                   abs(board[i]-c)!=r-i
                   for i in range(r)):
                board[r] = c
                if backtrack(r+1):
                    return True
        return False

    if backtrack(0):
        for c in board:
            print('. '*c+'Q '+' . '*(n-c-1))
    else:
        print("No solution")

solve(4)



4.2 Sudoku Solver
Program:

def solve(b):
    for r in range(9):
        for c in range(9):
            if b[r][c] == 0:
                for n in range(1,10):
                    if (n not in b[r] and
                        all(b[i][c]!=n for i in range(9)) and
                        all(b[i][j]!=n
                            for i in range(r//3*3,r//3*3+3)
                            for j in range(c//3*3,c//3*3+3))):
                        b[r][c] = n
                        if solve(b):
                            return True
                        b[r][c] = 0
                return False
    return True

b = [[0]*9 for _ in range(9)]
print(solve(b)) 


4.3 Map Coloring Problem
Program:


def color(graph,m):
    n = len(graph)
    colors = [0]*n

    def solve(v):
        if v == n:
            return True
        for c in range(1,m+1):
            if all(not graph[v][i] or colors[i]!=c
                   for i in range(n)):
                colors[v] = c
                if solve(v+1):
                    return True
                colors[v] = 0
        return False

    if solve(0):
        print(colors)
    else:
        print("No solution")

g = [[0,1,1],[1,0,1],[1,1,0]]
color(g,3)


